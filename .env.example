# 远程 OpenAI 兼容模型配置（占位符示例，复制为 .env 后填入真实值）
CUA_MODEL_API_KEY="<your-api-key>"
CUA_MODEL_BASE_URL="https://example.com/v1"
CUA_MODEL_NAME="<your-model-name>"

# 请求参数
CUA_MODEL_TIMEOUT_SECONDS=300
CUA_MODEL_MAX_TOKENS=32768
CUA_MODEL_JSON_MODE=false

# 本地 OpenAI 兼容服务通常不校验 key，但 DSH 需要一个非空占位值
DESKTOP_LOCAL_API_KEY=local

# Executor/Planner 与 Grounder 的 baseURL 和模型 ID 还需在以下文件中按环境修改（当前不使用 .env 插值）：
# - profiles/issue-agent/cordis.patch.yml
# - packages/desktop-agent/cordis.patch.yml

# 每轮观察最多取多少个 AX 元素（默认 300）；发送给模型前会按控件和上下文确定性精简，不调用额外模型
# DESKTOP_MAX_ELEMENTS=300

# 是否先用 Planner 扩写计划：false（默认，原始任务直接进入 Executor）或 true
# DESKTOP_PLANNER_ENABLED=false

# 浏览器状态：existing_profile（默认，附加本机 Chrome/Edge 登录态）、isolated_new、isolated_named
# issue-agent.sh 会复用已授权 daemon；缺失或未授权时才附加 --grant existing-profile 重启
# DESKTOP_BROWSER_PROFILE_MODE=existing_profile
# DESKTOP_BROWSER_PROFILE_NAME=issue-agent
# BROWSER_APP=Google Chrome
# BROWSER_LANG=en-US（通过 AppleLanguages 设置浏览器显示语言，会修改持久偏好）

# Executor 观察模式：screenshot（默认，只看截图，全部走 Grounder）或 hybrid（截图 + AX 文本）
# DESKTOP_OBSERVATION_MODE=screenshot

# Executor 思考模式：always（默认，每轮都思考）、adaptive（卡住才思考）、off（全程不思考）
# DESKTOP_THINKING_MODE=always

# 27B 思考强度：low（默认）/ medium / xhigh（服务端默认最高档）
# DESKTOP_THINKING_EFFORT=low

# GitHub issue 轮询插件（轮询本身不调用模型）
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN="<issues-read-write-token>"
GITHUB_TRIGGER_LABEL=agent:desktop
GITHUB_POLL_INTERVAL_SECONDS=60
GITHUB_MAX_ISSUES_PER_POLL=20
AGENT_TASK_TIMEOUT_SECONDS=600
