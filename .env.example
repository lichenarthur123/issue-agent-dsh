# 远程 OpenAI 兼容模型配置（占位符示例，复制为 .env 后填入真实值）
CUA_MODEL_API_KEY="<your-api-key>"
CUA_MODEL_BASE_URL="https://example.com/v1"
CUA_MODEL_NAME="<your-model-name>"

# 请求参数
CUA_MODEL_TIMEOUT_SECONDS=300
CUA_MODEL_MAX_TOKENS=32768
CUA_MODEL_JSON_MODE=false

# GitHub issue 轮询插件（轮询本身不调用模型）
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN="<issues-read-write-token>"
GITHUB_TRIGGER_LABEL=agent:desktop
GITHUB_POLL_INTERVAL_SECONDS=60
GITHUB_MAX_ISSUES_PER_POLL=20
AGENT_TASK_TIMEOUT_SECONDS=600
